{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-tree-model.local/schemas/completion-inventory.schema.json",
  "title": "Legacy source completion inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_project",
    "source_round",
    "source_complete",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_project": {
      "type": "string",
      "minLength": 1
    },
    "source_round": {
      "type": "string",
      "minLength": 1
    },
    "source_complete": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_path", "target_path", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": "string",
            "pattern": "^(artifacts|source|documentation)/"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
