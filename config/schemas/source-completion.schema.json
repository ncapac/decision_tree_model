{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-tree-model.local/schemas/source-completion.schema.json",
  "title": "Closed source round handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_project",
    "source_round",
    "status",
    "repository",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_project": {
      "type": "string",
      "minLength": 1
    },
    "source_round": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "complete"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "worktree_dirty",
        "status_sha256",
        "diff_sha256",
        "superproject_revision"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_dirty": {
          "type": "boolean"
        },
        "status_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "superproject_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source_path",
          "target_path",
          "sha256",
          "description"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": "string",
            "pattern": "^(artifacts|source|documentation)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
