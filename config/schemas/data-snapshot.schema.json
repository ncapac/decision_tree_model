{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-tree-model.local/schemas/data-snapshot.schema.json",
  "title": "Immutable data snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "status",
    "source",
    "imported_at_utc",
    "files",
    "datasets",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "status": {
      "enum": ["provisional", "final"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository_revision",
        "superproject_revision",
        "worktree_dirty"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "superproject_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_dirty": {
          "const": false
        }
      }
    },
    "imported_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_path", "target_path", "sha256"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "stage",
          "file_paths",
          "description",
          "provider",
          "license",
          "frequency",
          "units",
          "availability",
          "causality",
          "lineage"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]+$"
          },
          "stage": {
            "enum": ["raw", "curated"]
          },
          "file_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": ["string", "null"]
              }
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vintage_mode",
              "publication_lag",
              "as_of",
              "missingness_policy"
            ],
            "properties": {
              "vintage_mode": {
                "enum": [
                  "frozen_snapshot",
                  "latest_release",
                  "realtime_vintages",
                  "mixed"
                ]
              },
              "publication_lag": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "type": "string",
                "minLength": 1
              },
              "missingness_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "causality": {
            "type": "string",
            "minLength": 1
          },
          "lineage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
