{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-tree-model.local/schemas/data-snapshot.schema.json",
  "title": "Immutable data snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "status",
    "source",
    "imported_at_utc",
    "files",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$"
    },
    "status": {
      "enum": ["provisional", "final"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository_revision",
        "superproject_revision",
        "worktree_dirty"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "superproject_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_dirty": {
          "const": false
        }
      }
    },
    "imported_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_path", "target_path", "sha256"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
